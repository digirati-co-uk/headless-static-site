{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iiif-hss.dev/schemas/output-v1/resource-descriptors.schema.json",
  "title": "IIIF HSS per-resource output descriptors",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["hss:slug", "id", "type", "origin", "saved", "files"],
    "additionalProperties": false,
    "properties": {
      "hss:slug": { "type": "string", "minLength": 1 },
      "id": { "type": "string", "minLength": 1 },
      "type": { "enum": ["Manifest", "Collection"] },
      "inputKey": { "type": "string" },
      "origin": { "enum": ["source", "generated"] },
      "saved": { "type": "boolean" },
      "parents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "children": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "files": {
        "type": "object",
        "required": ["searchData", "extracted"],
        "additionalProperties": false,
        "properties": {
          "iiif": { "$ref": "#/$defs/relativePath" },
          "meta": { "$ref": "#/$defs/relativePath" },
          "indices": { "$ref": "#/$defs/relativePath" },
          "canvasIndex": { "$ref": "#/$defs/relativePath" },
          "searchRecord": { "$ref": "#/$defs/relativePath" },
          "searchData": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true },
          "extracted": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
