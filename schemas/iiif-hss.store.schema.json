{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/iiif-hss/iiif-hss.store.schema.json",
  "$comment": "Replace the placeholder host/path in $id when you publish this schema.",
  "title": "IIIF HSS Store Config",
  "description": "Schema for iiif-config/stores/*.json and iiif-config/stores/*/_store.json.",
  "oneOf": [
    { "$ref": "#/$defs/iiifJsonStore" },
    { "$ref": "#/$defs/iiifRemoteStore" }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ignoreValue": {
      "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/stringArray" }]
    },
    "storeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "networkConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1 },
        "minDelayMs": { "type": "integer", "minimum": 0 },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "baseDelayMs": { "type": "integer", "minimum": 0 },
        "maxDelayMs": { "type": "integer", "minimum": 0 },
        "jitterRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "retryStatuses": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "respectRetryAfter": { "type": "boolean" }
      }
    },
    "iiifJsonStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "type": { "const": "iiif-json" },
        "path": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string" },
        "ignore": { "$ref": "#/$defs/ignoreValue" },
        "subFiles": { "type": "boolean" },
        "base": { "type": "string" },
        "destination": { "type": "string" },
        "options": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/storeMetadata" },
        "slugTemplate": {
          "oneOf": [
            { "$ref": "#/$defs/slugConfig" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/slugConfig" }
            }
          ]
        },
        "slugTemplates": { "$ref": "#/$defs/stringArray" },
        "skip": { "$ref": "#/$defs/stringArray" },
        "run": { "$ref": "#/$defs/stringArray" },
        "config": { "type": "object", "additionalProperties": true },
        "inputKeys": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "iiifRemoteStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["url"] }, { "required": ["urls"] }],
      "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "type": { "const": "iiif-remote" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional publication checks. Omission preserves permissive discovery and fallback slug rules.",
          "properties": {
            "strict": {
              "type": "boolean",
              "description": "Fail invalid resources/pages, missing pages, unsafe final slugs and conflicting output slugs."
            },
            "requireSlugTemplate": {
              "type": "boolean",
              "description": "Require a matching named or inline slug template, independently of strict discovery."
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional limits; none are imposed when omitted. Counts include cached responses.",
          "properties": {
            "maxResources": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct attempted root and child URLs per store, including aliases."
            },
            "maxCollectionPages": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct linked collection-page URLs per store; excludes collection roots."
            },
            "maxChildren": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct direct child reference URLs per collection across all pages."
            }
          }
        },
        "url": { "type": "string", "format": "uri" },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "overrides": { "type": "string" },
        "saveManifests": { "type": "boolean" },
        "options": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/storeMetadata" },
        "slugTemplate": {
          "oneOf": [
            { "$ref": "#/$defs/slugConfig" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/slugConfig" }
            }
          ]
        },
        "slugTemplates": { "$ref": "#/$defs/stringArray" },
        "skip": { "$ref": "#/$defs/stringArray" },
        "run": { "$ref": "#/$defs/stringArray" },
        "config": { "type": "object", "additionalProperties": true },
        "destination": { "type": "string" },
        "network": { "$ref": "#/$defs/networkConfig" },
        "inputKeys": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "slugConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "domain"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Manifest", "Collection"]
        },
        "domain": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "examples": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "protocol": {
          "type": "string",
          "enum": ["http", "https"]
        },
        "pathSeparator": { "type": "string" },
        "addedPrefix": { "type": "string" }
      }
    }
  }
}
